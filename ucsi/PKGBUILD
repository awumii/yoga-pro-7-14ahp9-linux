pkgname=yoga-ucsi-dkms
pkgver=1.0
pkgrel=1
pkgdesc="DKMS module patching UCSI timeout to 500ms for Lenovo laptops"
arch=('x86_64')
license=('GPL-2.0-only')
depends=('dkms')
source=(
    'dkms.conf'
    'Makefile'
    'ucsi.c'
    'ucsi.h'
    'trace.c'
    'trace.h'
    'debugfs.c'
    'displayport.c'
    'thunderbolt.c'
    'psy.c'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    local install_dir="${pkgdir}/usr/src/${pkgname%-dkms}-${pkgver}"
    install -dm755 "$install_dir"

    local f
    for f in "${source[@]}"; do
        install -Dm644 "${srcdir}/$f" "${install_dir}/$f"
    done
}
